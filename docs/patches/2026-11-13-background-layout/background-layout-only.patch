+  const pending = new Set();
+  let delivered = 0;
+  const cancel = state => {
+    if (state.timer !== null) { clearTimeout(state.timer); pending.delete(state.timer); state.timer = null; }
+  };
+  const measureBody = target => {
+    if (target !== document.body || !target.isConnected || target.ownerDocument !== document) return null;
+    const css = getComputedStyle(target);
+    if (css.display === 'none' || css.visibility === 'hidden') return null;
+    const number = name => { const n = Number.parseFloat(css[name]); return Number.isFinite(n) ? n : 0; };
